{
  "version": 2,
  "builds": [
    {
      "src": "server.js",
      "use": "@vercel/node"
    },
    {
      "src": "public/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "server.js"
    },
    {
      "src": "/tree-removal",
      "dest": "/tree-removal.html"
    },
    {
      "src": "/tree-trimming",
      "dest": "/tree-trimming.html"
    },
    {
      "src": "/emergency",
      "dest": "/emergency.html"
    },
    {
      "src": "/portal",
      "dest": "/portal.html"
    },
    {
      "src": "/(.*)",
      "dest": "/public/$1"
    }
  ]
}
